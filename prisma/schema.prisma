// Schema do banco próprio (Supabase Postgres) — guarda apenas os dados que
// o eContador/ePlugin NÃO expõe. O vínculo com o cadastro da Alterdata é
// feito por cnpjCpf (chave estável, igual ao cpfCnpjAlfanumerico do eContador).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusCliente {
  ATIVO
  EM_ONBOARDING
  EM_OFFBOARDING
  INATIVO
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  ISENTO
}

enum StatusContrato {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum PapelUsuario {
  ADMIN
  CONTADOR
  ANALISTA
}

enum PeriodicidadeObrigacao {
  MENSAL
  ANUAL
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     PapelUsuario @default(CONTADOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientesFiscal   Cliente[] @relation("ResponsavelFiscal")
  clientesContabil Cliente[] @relation("ResponsavelContabil")
  clientesDp       Cliente[] @relation("ResponsavelDp")

  @@map("usuarios")
}

model Cliente {
  id     String @id @default(uuid())
  /// Vínculo com o eContador: mesmo valor de cpfCnpjAlfanumerico da Alterdata.
  cnpjCpf String @unique

  /// Cache opcional do id sequencial da empresa no dp.pack (evita round-trip extra).
  alterdataEmpresaId String?

  /// Cache de dados vindos do eContador (razão social, nome fantasia, código
  /// do cliente no eContador), para listar/ordenar sem consultar a Alterdata
  /// a cada requisição.
  nome         String?
  nomeFantasia String?
  codigo       String?

  status       StatusCliente @default(ATIVO)
  observacoes  String?

  /// Responsáveis internos do escritório, um por setor.
  responsavelFiscalId String?
  responsavelFiscal   Usuario? @relation("ResponsavelFiscal", fields: [responsavelFiscalId], references: [id])
  responsavelContabilId String?
  responsavelContabil   Usuario? @relation("ResponsavelContabil", fields: [responsavelContabilId], references: [id])
  responsavelDpId String?
  responsavelDp   Usuario? @relation("ResponsavelDp", fields: [responsavelDpId], references: [id])

  contatos     Contato[]
  endereco     Endereco?
  dadosFiscais DadosFiscais?
  contrato     Contrato?
  tags         ClienteTag[]
  documentos   DocumentoCliente[]
  acessos      AcessoCliente[]
  obrigacoes   ObrigacaoCliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clientes")
}

/// Cofre de acessos a portais de terceiros (gov.br, prefeitura etc.) por cliente.
/// A senha nunca é gravada em texto puro — ver src/common/crypto.util.ts.
model AcessoCliente {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  portal       String
  login        String?
  senhaCifrada String
  observacoes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("acessos_cliente")
}

/// Catálogo de obrigações fiscais recorrentes (DAS, DCTF, DEFIS, ECF etc.) — extensível.
model TipoObrigacaoFiscal {
  id            String                  @id @default(uuid())
  nome          String                  @unique
  periodicidade PeriodicidadeObrigacao

  /// Dia do mês em que vence (1-31).
  diaVencimento Int

  /// Só usado quando periodicidade = ANUAL (1-12).
  mesVencimento Int?

  /// Regimes tributários aos quais essa obrigação se aplica; vazio = todos.
  regimesAplicaveis RegimeTributario[]

  ativo Boolean @default(true)

  obrigacoes ObrigacaoCliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tipos_obrigacao_fiscal")
}

/// Uma obrigação fiscal de um cliente numa competência específica — gerada em lote
/// (ver ObrigacoesClienteService.gerar), não digitada uma a uma.
model ObrigacaoCliente {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipoObrigacaoId String
  tipoObrigacao   TipoObrigacaoFiscal @relation(fields: [tipoObrigacaoId], references: [id])

  /// "2026-08" (mensal) ou "2026" (anual).
  competencia    String
  dataVencimento DateTime  @db.Date
  cumprida       Boolean   @default(false)
  cumpridaEm     DateTime?
  observacoes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, tipoObrigacaoId, competencia])
  @@map("obrigacoes_cliente")
}

/// Catálogo de tipos de documento controlados (Alvará de Funcionamento,
/// Vigilância Sanitária, Conselho de Classe, etc.) — extensível pelo usuário.
model TipoDocumento {
  id   String @id @default(uuid())
  nome String @unique

  /// Informativo, para ajudar a estimar a próxima renovação (ex.: 12 = anual).
  periodicidadeMeses Int?

  ativo Boolean @default(true)

  documentos DocumentoCliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tipos_documento")
}

/// Um documento controlado de um cliente específico, com data de vencimento
/// — a peça central do módulo de controle/alertas de vencimento.
model DocumentoCliente {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipoDocumentoId String
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])

  dataEmissao    DateTime? @db.Date
  dataVencimento DateTime  @db.Date
  observacoes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documentos_cliente")
}

model Contato {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome      String
  cargo     String?
  telefone  String?
  whatsapp  String?
  email     String?
  principal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contatos")
}

model Endereco {
  id        String  @id @default(uuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  cep         String?
  rua         String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  @@map("enderecos")
}

model DadosFiscais {
  id        String  @id @default(uuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  regimeTributario   RegimeTributario?
  cnaePrincipal      String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?

  /// Não vem do eContador — a Alterdata não expõe esses dados pelo ePlugin,
  /// precisa ser preenchido manualmente.
  capitalSocial Decimal?  @db.Decimal(14, 2)
  dataAbertura  DateTime? @db.Date

  @@map("dados_fiscais")
}

model Contrato {
  id        String  @id @default(uuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  valorHonorarios Decimal?        @db.Decimal(10, 2)
  diaVencimento   Int?
  formaPagamento  String?
  dataInicio      DateTime?       @db.Date
  status          StatusContrato  @default(ATIVO)
  observacoes     String?

  @@map("contratos")
}

model Tag {
  id   String @id @default(uuid())
  nome String @unique

  clientes ClienteTag[]

  @@map("tags")
}

model ClienteTag {
  clienteId String
  tagId     String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clienteId, tagId])
  @@map("cliente_tags")
}
