# Token gerado em: eContador > Configurações > ePlugin > Gerar
# (exige o pacote eContador Master)
ALTERDATA_TOKEN=

# Base URLs dos microsserviços do ePlugin (normalmente não precisam mudar)
ALTERDATA_DP_URL=https://dp.pack.alterdata.com.br
ALTERDATA_ATENDIMENTOS_URL=https://atendimentos.pack.alterdata.com.br
ALTERDATA_CND_URL=https://cnd.pack.alterdata.com.br
ALTERDATA_DOCUMENTOS_URL=https://documentos.pack.alterdata.com.br
ALTERDATA_IDENTIFICACAO_URL=https://identificacao.pack.alterdata.com.br
ALTERDATA_TAREFAS_URL=https://ms-tarefas.pack.alterdata.com.br

ALTERDATA_TIMEOUT_MS=15000

PORT=3000

# Connection string do Postgres (Supabase). No painel do Supabase: botão
# "Connect" no topo do projeto > "Direct connection" (backend persistente,
# não serverless).
DATABASE_URL=

# Segredo para assinar os JWTs de login. Gere um valor aleatório, ex.:
# `openssl rand -base64 48` ou `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Credenciais do primeiro usuário admin, usadas apenas pelo script de seed
# (npx prisma db seed). Pode apagar depois de rodar o seed uma vez.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
